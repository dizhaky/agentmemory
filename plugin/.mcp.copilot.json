{
  "mcpServers": {
    "agentmemory": {
      "type": "local",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "${AGENTMEMORY_URL:-http://localhost:3111}",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET:-}",
        "AGENTMEMORY_TOOLS": "${AGENTMEMORY_TOOLS:-all}",
        "PATH": "/opt/homebrew/bin:/Users/danizhaky/.hermes/node/bin:/Users/danizhaky/.nvm/versions/node/v24.11.0/bin:/Users/danizhaky/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      },
      "tools": [
        "*"
      ]
    }
  }
}